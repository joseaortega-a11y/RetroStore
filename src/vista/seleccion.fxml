<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650" prefWidth="360"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.SeleccionesController">

    <children>

        <!-- Título -->
        <Text layoutX="20" layoutY="50" text="Categoria">
            <font><Font name="System Bold" size="18"/></font>
        </Text>

        <Text layoutX="140" layoutY="50" text="Selecciones.">
            <font><Font size="14"/></font>
        </Text>

        <!-- Scroll principal -->
        <ScrollPane fitToWidth="true" layoutX="10" layoutY="70"
                    prefHeight="474" prefWidth="340">

            <content>
                <VBox spacing="25" style="-fx-padding: 10;">

                    <!-- ========== FILA 1 ========== -->
                    <HBox alignment="CENTER" spacing="15">

                        <!-- Alemanha -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/alemania2006.png"/></image>
                            </ImageView>
                            <Text text="Alemania 2006"/>
                            <Button fx:id="btnCarritoAlemania" onAction="#carritoAlemania" prefWidth="120" text="Carrito"/>
                            <Button fx:id="btnFavAlemania" onAction="#favoritoAlemania" prefWidth="120" text="Favoritos"/>
                        </VBox>

                        <Separator orientation="VERTICAL" prefHeight="150"/>

                        <!-- Italia -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/italia1996.png"/></image>
                            </ImageView>
                            <Text text="Italia 1996"/>
                            <Button onAction="#carritoItalia" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoItalia" prefWidth="120" text="Favoritos"/>
                        </VBox>
                    </HBox>

                    <!-- ========== FILA 2 ========== -->
                    <HBox alignment="CENTER" spacing="15">

                        <!-- España -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/espana2006.png"/></image>
                            </ImageView>
                            <Text text="España 2006"/>
                            <Button onAction="#carritoEspaña" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoEspaña" prefWidth="120" text="Favoritos"/>
                        </VBox>

                        <Separator orientation="VERTICAL" prefHeight="150"/>

                        <!-- Croacia -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/croacia1996.png"/></image>
                            </ImageView>
                            <Text text="Croacia 1996"/>
                            <Button onAction="#carritoCroacia" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoCroacia" prefWidth="120" text="Favoritos"/>
                        </VBox>
                    </HBox>

                    <!-- ========== FILA 3 ========== -->
                    <HBox alignment="CENTER" spacing="15">

                        <!-- Portugal -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/portugal2002.png"/></image>
                            </ImageView>
                            <Text text="Portugal 2002"/>
                            <Button onAction="#carritoPortugal" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoPortugal" prefWidth="120" text="Favoritos"/>
                        </VBox>

                        <Separator orientation="VERTICAL" prefHeight="150"/>

                        <!-- Brasil -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/brasil2002.png"/></image>
                            </ImageView>
                            <Text text="Brasil 2002"/>
                            <Button onAction="#carritoBrasil" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoBrasil" prefWidth="120" text="Favoritos"/>
                        </VBox>
                    </HBox>

                    <!-- ========== FILA 4 ========== -->
                    <HBox alignment="CENTER" spacing="15">

                        <!-- Francia -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/francia2006.png"/></image>
                            </ImageView>
                            <Text text="Francia 2006"/>
                            <Button onAction="#carritoFrancia" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoFrancia" prefWidth="120" text="Favoritos"/>
                        </VBox>

                        <Separator orientation="VERTICAL" prefHeight="150"/>

                        <!-- Argentina -->
                        <VBox prefWidth="140" spacing="5"
                              style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                            <ImageView fitHeight="120" fitWidth="120" preserveRatio="true">
                                <image><Image url="@../imagenes/argentina2006.png"/></image>
                            </ImageView>
                            <Text text="Argentina 2006"/>
                            <Button onAction="#carritoArgentina" prefWidth="120" text="Carrito"/>
                            <Button onAction="#favoritoArgentina" prefWidth="120" text="Favoritos"/>
                        </VBox>
                    </HBox>

                </VBox>
            </content>

        </ScrollPane>

    </children>

</AnchorPane>
