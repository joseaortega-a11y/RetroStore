<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650" prefWidth="360"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controlador.ClubesController">

    <!-- Buscador -->
    <HBox layoutX="4" layoutY="19" spacing="10"
          style="-fx-background-color:#f4f4f4; -fx-background-radius:20; -fx-padding:10;">
        <ImageView fitHeight="20" fitWidth="20">
            <image>
                <Image url="@../imagenes/Busqueda.png"/>
            </image>
        </ImageView>
    </HBox>

    <Text layoutX="20" layoutY="132" text="Categoría: Clubes">
        <font>
            <Font name="System Bold" size="14"/>
        </font>
    </Text>

    <!-- CONTENEDOR GENERAL -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                layoutX="20" layoutY="154" prefHeight="406" prefWidth="320">
        <content>
            <VBox fx:id="contenedorPrincipal" spacing="20">

                <!-- FILA 1 -->
                <HBox spacing="20">
                    <!-- Chelsea -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/chelsea.png"/>
                            </image>
                        </ImageView>
                        <Text>Chelsea 2007-2008</Text>
                        <Button onAction="#carritoChelsea" text="Carrito"/>
                        <Button onAction="#favoritoChelsea" text="Favoritos"/>
                    </VBox>

                    <!-- Arsenal -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/arsenal.png"/>
                            </image>
                        </ImageView>
                        <Text>Arsenal 2004-2005</Text>
                        <Button onAction="#carritoArsenal" text="Carrito"/>
                        <Button onAction="#favoritoArsenal" text="Favoritos"/>
                    </VBox>
                </HBox>

                <!-- FILA 2 -->
                <HBox spacing="20">
                    <!-- Liverpool -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/liverpool.png"/>
                            </image>
                        </ImageView>
                        <Text>Liverpool 2006-2007</Text>
                        <Button onAction="#carritoLiverpool" text="Carrito"/>
                        <Button onAction="#favoritoLiverpool" text="Favoritos"/>
                    </VBox>

                    <!-- Barcelona -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/barsa.png"/>
                            </image>
                        </ImageView>
                        <Text>Barcelona 2008-2009</Text>
                        <Button onAction="#carritoBarcelona" text="Carrito"/>
                        <Button onAction="#favoritoBarcelona" text="Favoritos"/>
                    </VBox>
                </HBox>

                <!-- FILA 3 -->
                <HBox spacing="20">
                    <!-- United -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/united.png"/>
                            </image>
                        </ImageView>
                        <Text>United 2002-2004</Text>
                        <Button onAction="#carritoUnited" text="Carrito"/>
                        <Button onAction="#favoritoUnited" text="Favoritos"/>
                    </VBox>

                    <!-- Real Madrid -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/madrid.png"/>
                            </image>
                        </ImageView>
                        <Text>Real Madrid 2011-2012</Text>
                        <Button onAction="#carritoMilan" text="Carrito"/>
                        <Button onAction="#favoritoMilan" text="Favoritos"/>
                    </VBox>
                </HBox>

                <!-- FILA 4 -->
                <HBox spacing="20">
                    <!-- Milan -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/milan.png"/>
                            </image>
                        </ImageView>
                        <Text>Milan 2006-2007</Text>
                        <Button onAction="#carritoMilan" text="Carrito"/>
                        <Button onAction="#favoritoMilan" text="Favoritos"/>
                    </VBox>

                    <!-- City -->
                    <VBox prefWidth="140" spacing="5" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-background-radius:10;">
                        <ImageView fitHeight="120" fitWidth="120">
                            <image>
                                <Image url="@../imagenes/city.png"/>
                            </image>
                        </ImageView>
                        <Text>City 1997-1998</Text>
                        <Button onAction="#carritoCity" text="Carrito"/>
                        <Button onAction="#favoritoCity" text="Favoritos"/>
                    </VBox>
                </HBox>

            </VBox>
        </content>
    </ScrollPane>

    <TextField fx:id="txtBuscar" layoutX="77" layoutY="26"
               prefHeight="27" prefWidth="257"
               promptText="Buscar clubes..."
               style="-fx-background-color:#D3D3D3; -fx-border-color:transparent;"/>

    <Button layoutX="206" layoutY="114"
            style="-fx-background-color:#D3D3D3;"
            text="Ver Selecciones"
            onAction="#irASelecciones"/>

</AnchorPane>
