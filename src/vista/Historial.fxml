      </Text>

      <TextField fx:id="txtBuscar" layoutX="60.0" layoutY="25.0" prefWidth="250" promptText="Buscar en el historial..." />
      <HBox layoutX="14.0" layoutY="18.0" prefHeight="0.0" prefWidth="0.0" spacing="10" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 10;">
         <children>
           
